# Copy this file to .env (it is git-ignored) and change the passwords.
# docker-compose reads the three *_PASSWORD values, and the API reads the ConnectionStrings and Mongo values.

POSTGRES_PASSWORD=headlesscms_dev
REDIS_PASSWORD=redis_dev
MONGO_PASSWORD=mongo_dev

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=headlesscms;Username=headlesscms;Password=headlesscms_dev
ConnectionStrings__Redis=localhost:6379,password=redis_dev
ConnectionStrings__Mongo=mongodb://headlesscms:mongo_dev@localhost:27017/?authSource=admin
Mongo__Database=headlesscms

# Logging (optional). See the README.
# Logship__File__Enabled=true
# Logship__Loki__Url=http://localhost:3100

# Secrets for the settings the app checks at start-up. These two values are for LOCAL DEVELOPMENT ONLY:
# anyone can read them here. Generate your own for any deployed environment:
#   openssl rand -base64 48     (Jwt__SigningKey)
#   openssl rand -base64 32     (Security__TwoFactorEncryptionKey)
Jwt__SigningKey=trEU06L63wQ+a0mVb9Vv7PXOCfXrLj8u14bSAuMLi3XiEWbIhkU6MkDP6A8gXby3
Security__TwoFactorEncryptionKey=BAHdBzfWWW8qUMJqEfUrRgIcJpyJxWFZkelCRNyi17o=
