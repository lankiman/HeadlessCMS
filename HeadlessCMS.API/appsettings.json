{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "headlesscms",
    "Audience": "headlesscms-clients",
    "AccessTokenMinutes": 15
  },
  "Mongo": {
    "Database": "headlesscms"
  },
  "Logship": {
    "Loki": {
      "Url": "",
      "AppLabel": "headless-cms",
      "JobLabel": "headless-cms"
    },
    "File": {
      "Enabled": false,
      "Directory": "logs"
    }
  },
  "AllowedHosts": "*"
}
